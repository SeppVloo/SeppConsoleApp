@page "/"
@using PongWeb.Game
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_mode is not null)
{
	<div class="game">
		<div class="game-bar">
			<button class="btn icon" @onclick="Leave">← Stoppen</button>
			<span class="versus">
				<span class="@(_side % 2 == 0 ? "me" : "them")">@TeamLabel(0)</span>
				<span class="vs">VS</span>
				<span class="@(_side % 2 == 1 ? "me" : "them")">@TeamLabel(1)</span>
			</span>
			<span style="display:flex;gap:.4rem">
				<button class="btn icon" @onclick="TogglePauseClick">⏯ Pauze</button>
				<button class="btn icon" @onclick="RestartGame">↻ Opnieuw</button>
			</span>
		</div>
		<canvas @ref="_canvas" width="800" height="450" class="pong-canvas"></canvas>
		<div class="hint">Sleep met je vinger over het veld om je batje te bewegen</div>
	</div>
}
else
{
	<div class="lobby">
		<h1 class="logo">PONG</h1>
		<p class="tagline">Speel samen op hetzelfde wifi-netwerk</p>

		<div class="card">
			<label>JOUW NAAM</label>
			<input class="input" value="@_name" @onchange="NameChanged" maxlength="20" />
		</div>

		@if (_status is not null)
		{
			<div class="status">@_status</div>
		}

		@if (_hosting)
		{
			<div class="card waiting">
				<div class="radar"></div>
				<p>Wachten op spelers... (@_lobbyPlayers.Count / @RemoteSlots().Count)</p>
				@if (_lobbyPlayers.Count > 0)
				{
					<p class="muted small">@string.Join(", ", _lobbyPlayers)</p>
				}
				<button class="btn wide" @onclick="CancelHosting">Annuleren</button>
			</div>
		}
		else
		{
			<div class="card">
				<h3>Spel</h3>
				<div class="seg">
					<button class="btn @(_teamSize == 1 ? "sel" : "")" @onclick="() => SetTeamSize(1)">1 tegen 1</button>
					<button class="btn @(_teamSize == 2 ? "sel" : "")" @onclick="() => SetTeamSize(2)">2 tegen 2</button>
				</div>
				<div class="teams">
					@for (var t = 0; t < 2; t++)
					{
						var team = t;
						<div class="team">
							<label>@(team == 0 ? "JOUW TEAM" : "TEGENSTANDERS")</label>
							@foreach (var s in Enumerable.Range(0, _teamSize * 2).Where(s => s % 2 == team))
							{
								var slot = s;
								if (slot == 0)
								{
									<div class="seat me">🙂 Jij</div>
								}
								else
								{
									var ai = (_aiMask & (1 << slot)) != 0;
									<button class="btn seat @(ai ? "ai" : "")" @onclick="() => ToggleSeat(slot)">@(ai ? "🤖 Computer" : "👤 Speler")</button>
									@if (ai)
									{
										<div class="seg speed">
											@for (var lv = 0; lv < AiLevels.Length; lv++)
											{
												var l = lv;
												<button class="btn @(_aiLevel[slot] == l ? "sel" : "")" title="@AiLevels[l].Name" @onclick="() => SetAiLevel(slot, l)">@AiLevels[l].Icon</button>
											}
										</div>
									}
								}
							}
						</div>
					}
				</div>
				<p class="muted small" style="margin:.5rem 0 0">Tik op een plek om te wisselen tussen speler en computer.</p>
				<p class="muted small" style="margin:.5rem 0 .75rem">@SetupText()</p>
				<button class="btn primary wide" @onclick="Start">▶ @(RemoteSlots().Count == 0 ? "Spelen" : "Nieuw spel starten")</button>
			</div>

			<div class="card">
				<h3>@if (_netReady) { <span class="live-dot"></span> } Spellen in de buurt</h3>
				@if (!_netReady)
				{
					<p class="empty">Verbinden...</p>
				}
				else if (_peers.All(p => !p.Hosting))
				{
					<p class="empty small">Nog niemand gevonden. Laat iemand anders "Nieuw spel starten" kiezen.</p>
				}
				@foreach (var peer in _peers.Where(p => p.Hosting))
				{
					<button class="btn success wide" @onclick="() => Join(peer.Id)"><span>@peer.Name</span><span>Meedoen →</span></button>
				}
				@if (_peers.Any(p => !p.Hosting))
				{
					<p class="muted small" style="margin:.5rem 0 0">Ook online: @string.Join(", ", _peers.Where(p => !p.Hosting).Select(p => p.Name))</p>
				}
			</div>
			@if (_diag is not null)
			{
				<details class="diag">
					<summary>Verbindingsinfo</summary>
					<div>Lobby-code: <b>@_diag.Room[^Math.Min(6, _diag.Room.Length)..]</b> @(_diag.IpOk ? "" : "(IP niet gevonden!)")</div>
					<div>Signaal-servers: <b>@_diag.Relays / @_diag.RelaysTotal</b> verbonden</div>
					<div>Directe verbindingen: <b>@_diag.Peers</b></div>
					<div>Berichten ontvangen: <b>@_diag.Hellos</b></div>
					<div class="small">Lobby-code moet op alle apparaten gelijk zijn. 0 signaal-servers = netwerk/contentblocker blokkeert ze.</div>
				</details>
			}
		}

		<div class="card">
			<h3>Power-ups <span class="muted small" style="text-transform:none;letter-spacing:0;font-weight:400">· tik om aan/uit te zetten</span></h3>
			<ul class="powerups">
				@for (var i = 0; i < PowerUpRegistry.All.Count; i++)
				{
					var idx = i;
					var pu = PowerUpRegistry.All[i];
					var on = !_disabled.Contains(idx);
					<li class="toggle @(on ? "on" : "off")" @onclick="() => TogglePowerUp(idx)"><span class="dot" style="background:@pu.Color;color:@pu.Color"><span style="color:#0b1026">@pu.Symbol</span></span> <span class="pu-name">@pu.Name</span><span class="switch"></span></li>
				}
			</ul>
			<ul class="powerups" style="grid-template-columns:1fr;margin-top:.5rem">
				<li class="toggle @(_keep ? "on" : "off")" @onclick="ToggleKeep"><span class="pu-name">Power-ups blijven staan na een goal</span><span class="switch"></span></li>
				<li><span class="pu-name">Muurtje: min. bounces</span><button class="btn icon" @onclick="() => SetWall(_wallMin - 1, _wallMax)">−</button><b style="min-width:1.5rem;text-align:center">@_wallMin</b><button class="btn icon" @onclick="() => SetWall(_wallMin + 1, _wallMax)">+</button></li>
				<li><span class="pu-name">Muurtje: max. bounces</span><button class="btn icon" @onclick="() => SetWall(_wallMin, _wallMax - 1)">−</button><b style="min-width:1.5rem;text-align:center">@_wallMax</b><button class="btn icon" @onclick="() => SetWall(_wallMin, _wallMax + 1)">+</button></li>
				<li><span class="pu-name">Muurtje: min. grootte</span><button class="btn icon" @onclick="() => SetWallSize(_wallSizeMin - WallSizeStep, _wallSizeMax)">−</button><b style="min-width:2.2rem;text-align:center">@_wallSizeMin</b><button class="btn icon" @onclick="() => SetWallSize(_wallSizeMin + WallSizeStep, _wallSizeMax)">+</button></li>
				<li><span class="pu-name">Muurtje: max. grootte</span><button class="btn icon" @onclick="() => SetWallSize(_wallSizeMin, _wallSizeMax - WallSizeStep)">−</button><b style="min-width:2.2rem;text-align:center">@_wallSizeMax</b><button class="btn icon" @onclick="() => SetWallSize(_wallSizeMin, _wallSizeMax + WallSizeStep)">+</button></li>
			</ul>
			<p class="muted small" style="margin:.6rem 0 0">Max @PongEngine.MaxPickups power-ups tegelijk in het veld. Bij online spelen gelden de instellingen van wie het spel start.</p>
		</div>
	</div>
}

@code {
	public record Peer(string Id, string Name, bool Hosting);
	public record Diag(string Room, bool IpOk, int Relays, int RelaysTotal, int Peers, int Hellos);
	private Diag? _diag;

	[JSInvokable]
	public void OnDiag(Diag diag)
	{
		_diag = diag;
		StateHasChanged();
	}

	private ElementReference _canvas;
	private DotNetObjectReference<Home>? _self;
	private IJSObjectReference? _net, _pong;
	private PongEngine? _engine;
	private string? _mode;           // "practice" | "host" | "client"
	private bool _startCanvas;
	private int _side;
	private string _name = "";
	private string? _status;
	private bool _hosting, _netReady;
	private List<Peer> _peers = [];
	private HashSet<int> _disabled = [];

	private async Task TogglePowerUp(int i)
	{
		if (!_disabled.Remove(i)) _disabled.Add(i);
		await JS.InvokeVoidAsync("localStorage.setItem", "pongDisabledPowerUps", string.Join(",", _disabled));
	}

	private bool _keep;

	private async Task ToggleKeep()
	{
		_keep = !_keep;
		await JS.InvokeVoidAsync("localStorage.setItem", "pongKeepPowerUps", _keep ? "1" : "0");
	}

	private PongEngine NewEngine()
	{
		var e = new PongEngine
		{
			TeamSize = _teamSize,
			KeepPowerUpsOnGoal = _keep,
			WallMinHits = _wallMin,
			WallMaxHits = _wallMax,
			WallMinSize = _wallSizeMin,
			WallMaxSize = _wallSizeMax,
			EnabledPowerUps = Enumerable.Range(0, PowerUpRegistry.All.Count).Where(i => !_disabled.Contains(i)).ToArray(),
			TeamNames = [TeamLabel(0), TeamLabel(1)],
		};
		foreach (var s in AiSlots()) { e.Ai[s] = true; e.AiSpeed[s] = AiLevels[_aiLevel[s]].Speed; }
		e.Reset();
		return e;
	}

	// --- Game setup ---
	private int _teamSize = 1, _aiMask = 0b0010, _wallMin = 3, _wallMax = 3;
	private const int WallSizeStep = 10;
	private int _wallSizeMin = 110, _wallSizeMax = 110;
	private string[] _slotNames = new string[PongEngine.MaxSlots];
	private List<string> _lobbyPlayers = [];

	private List<int> AiSlots() => Enumerable.Range(1, _teamSize * 2 - 1).Where(s => (_aiMask & (1 << s)) != 0).ToList();
	private List<int> RemoteSlots() => Enumerable.Range(1, _teamSize * 2 - 1).Except(AiSlots()).ToList();

	private string SetupText()
	{
		var ai = AiSlots();
		string Who(int s) => s == 0 ? "Jij" : ai.Contains(s) ? "🤖" : "👤";
		var teams = string.Join(" vs ", Enumerable.Range(0, 2).Select(t =>
			string.Join(" + ", Enumerable.Range(0, _teamSize * 2).Where(s => s % 2 == t).Select(Who))));
		var r = RemoteSlots().Count;
		return teams + (r == 0 ? "" : $" · wacht op {r} andere speler{(r > 1 ? "s" : "")} op dit wifi-netwerk");
	}

	private string TeamLabel(int team)
	{
		var names = Enumerable.Range(0, _teamSize * 2).Where(s => s % 2 == team).Select(s => _slotNames[s] ?? "?");
		return string.Join(" & ", names);
	}

	private async Task SetTeamSize(int n)
	{
		_teamSize = n;
		await SaveSetup();
	}

	private static readonly (string Icon, string Name, float Speed)[] AiLevels =
	[
		("🐢", "Langzaam", 0.45f), ("🚶", "Normaal", 0.7f), ("🏃", "Snel", 0.9f), ("🚀", "Supersnel", 1.1f),
	];
	private int[] _aiLevel = [1, 1, 1, 1];

	private async Task SetAiLevel(int slot, int level)
	{
		_aiLevel[slot] = level;
		await SaveSetup();
	}

	private async Task ToggleSeat(int slot)
	{
		_aiMask ^= 1 << slot;
		await SaveSetup();
	}

	private async Task SetWallSize(int min, int max)
	{
		min = Math.Clamp(min, 30, 250);
		max = Math.Clamp(max, 30, 250);
		if (min != _wallSizeMin && min > max) max = min;
		if (max != _wallSizeMax && max < min) min = max;
		_wallSizeMin = min; _wallSizeMax = max;
		await SaveSetup();
	}

	private async Task SetWall(int min, int max)
	{
		min = Math.Clamp(min, 1, 10);
		max = Math.Clamp(max, 1, 10);
		if (min != _wallMin && min > max) max = min;
		if (max != _wallMax && max < min) min = max;
		_wallMin = min; _wallMax = max;
		await SaveSetup();
	}

	private async Task SaveSetup() =>
		await JS.InvokeVoidAsync("localStorage.setItem", "pongSetup2", $"{_teamSize},{_aiMask},{_wallMin},{_wallMax},{_wallSizeMin},{_wallSizeMax},{string.Join('-', _aiLevel)}");

	private async Task LoadSetup()
	{
		var v = await JS.InvokeAsync<string?>("localStorage.getItem", "pongSetup2");
		var raw = (v ?? "").Split(',');
		if (raw.Length == 7)
			_aiLevel = raw[6].Split('-').Select(x => int.TryParse(x, out var n) ? Math.Clamp(n, 0, AiLevels.Length - 1) : 1).Concat(Enumerable.Repeat(1, 4)).Take(4).ToArray();
		var p = raw.Take(6).Select(x => int.TryParse(x, out var n) ? n : 0).ToArray();
		if (p.Length != 6) return;
		_teamSize = Math.Clamp(p[0], 1, 2);
		_aiMask = p[1] & 0b1110;
		_wallMin = Math.Clamp(p[2], 1, 10);
		_wallMax = Math.Clamp(p[3], _wallMin, 10);
		_wallSizeMin = Math.Clamp(p[4], 30, 250);
		_wallSizeMax = Math.Clamp(p[5], _wallSizeMin, 250);
	}

	private static readonly string[] BotNames =
	[
		"🤖 Robo Rik", "🦾 Bleep Bloop", "👾 Pixel Piet", "🛸 Captain Byte", "⚡ Turbo Tessa", "🐙 Octo-Otto",
		"🦖 Dino Dirk", "🍕 Pizza Pong", "🐸 Kikker Karel", "🚀 Rocket Rosa", "🧠 Brein Bert", "🦄 Uni Unit",
		"🍌 Banaan-o-Bot", "🐧 Pinguïn Pim", "🔋 Batterij Bas", "🎩 Meneer Megahertz",
	];

	private void FillSlotNames()
	{
		_slotNames = new string[PongEngine.MaxSlots];
		_slotNames[0] = _name;
		var names = BotNames.OrderBy(_ => Random.Shared.Next()).ToArray();
		var i = 0;
		foreach (var s in AiSlots()) _slotNames[s] = names[i++];
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_self = DotNetObjectReference.Create(this);
			_name = await JS.InvokeAsync<string?>("localStorage.getItem", "pongName") ?? $"Speler {Random.Shared.Next(100, 999)}";
			var dis = await JS.InvokeAsync<string?>("localStorage.getItem", "pongDisabledPowerUps");
			if (!string.IsNullOrEmpty(dis))
				_disabled = dis.Split(',').Select(x => int.TryParse(x, out var n) ? n : -1).Where(n => n >= 0).ToHashSet();
			_keep = await JS.InvokeAsync<string?>("localStorage.getItem", "pongKeepPowerUps") == "1";
			await LoadSetup();
			_pong = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pong.js");
			_net = await JS.InvokeAsync<IJSObjectReference>("import", "./js/net.js");
			StateHasChanged();
			try
			{
				await _net.InvokeVoidAsync("start", _self, _name);
				_netReady = true;
			}
			catch (JSException ex)
			{
				_status = $"Online spelen niet beschikbaar: {ex.Message}";
			}
			StateHasChanged();
		}

		if (_startCanvas && _mode is not null && _pong is not null)
		{
			_startCanvas = false;
			var info = PowerUpRegistry.All.Select(p => new { color = p.Color, symbol = p.Symbol });
			await _pong.InvokeVoidAsync("start", _canvas, _self, _mode, _side, info);
		}
	}

	private async Task NameChanged(ChangeEventArgs e)
	{
		var name = e.Value?.ToString()?.Trim();
		if (string.IsNullOrEmpty(name)) return;
		_name = name;
		await JS.InvokeVoidAsync("localStorage.setItem", "pongName", _name);
		if (_netReady) await _net!.InvokeVoidAsync("setName", _name);
	}

	private async Task Start()
	{
		FillSlotNames();
		if (RemoteSlots().Count == 0)
		{
			_engine = NewEngine();
			BeginGame("practice", 0);
			return;
		}
		if (!_netReady) return;
		_status = null;
		_hosting = true;
		_lobbyPlayers = [];
		var known = Enumerable.Range(0, PongEngine.MaxSlots).Where(s => _slotNames[s] is not null).Select(s => new SlotName(s, _slotNames[s])).ToList();
		await _net!.InvokeVoidAsync("setHosting", true, RemoteSlots(), known);
	}

	private async Task CancelHosting()
	{
		_hosting = false;
		await _net!.InvokeVoidAsync("setHosting", false, Array.Empty<int>());
	}

	private async Task Join(string peerId)
	{
		_status = "Verbinden...";
		await _net!.InvokeVoidAsync("join", peerId);
	}

	private void BeginGame(string mode, int side)
	{
		_mode = mode;
		_side = side;
		_status = null;
		_hosting = false;
		_startCanvas = true;
	}

	private async Task Leave()
	{
		if (_pong is not null) await _pong.InvokeVoidAsync("stop");
		if (_mode is "host" or "client") await _net!.InvokeVoidAsync("leave");
		_mode = null;
		_engine = null;
	}

	private async Task TogglePauseClick()
	{
		if (_pong is not null) await _pong.InvokeVoidAsync("togglePause");
	}

	[JSInvokable]
	public void TogglePause()
	{
		if (_engine is not null) _engine.Paused = !_engine.Paused;
	}

	private async Task RestartGame()
	{
		if (_pong is not null) await _pong.InvokeVoidAsync("restart");
	}

	// --- Called from JavaScript ---

	[JSInvokable]
	public void OnPeers(List<Peer> peers)
	{
		_peers = peers;
		StateHasChanged();
	}

	[JSInvokable]
	public void OnStatus(string status)
	{
		_status = status;
		StateHasChanged();
	}

	public record SlotName(int Slot, string Name);

	[JSInvokable]
	public void OnLobbyPlayers(List<string> names)
	{
		_lobbyPlayers = names;
		StateHasChanged();
	}

	[JSInvokable]
	public void OnGameStart(int slot, List<SlotName> remote)
	{
		if (slot == 0)
		{
			foreach (var r in remote) _slotNames[r.Slot] = r.Name;
			_engine = NewEngine();
		}
		else
		{
			// Client: the snapshot tells us the team size; names come from the host.
			_slotNames = new string[PongEngine.MaxSlots];
			foreach (var r in remote) _slotNames[r.Slot] = r.Name;
			_teamSize = remote.Count > 2 ? 2 : 1;
			_engine = null;
		}
		BeginGame(slot == 0 ? "host" : "client", slot);
		StateHasChanged();
	}

	[JSInvokable]
	public void OnPlayerLeft(int slot, string name)
	{
		if (_engine is null) return;
		_engine.Ai[slot] = true;
		_slotNames[slot] = $"{name} (computer)";
		StateHasChanged();
	}

	[JSInvokable]
	public async Task OnGameEnd(string reason)
	{
		if (_pong is not null) await _pong.InvokeVoidAsync("stop");
		_mode = null;
		_engine = null;
		_status = reason;
		StateHasChanged();
	}

	[JSInvokable]
	public GameState? Tick(float dt)
	{
		if (_engine is null) return null;
		// Fixed 1/120 s substeps so a fast ball can't skip through a paddle on a slow frame.
		// Split the frame into equal substeps (≤ 1/120 s) so every frame advances by exactly dt — no judder.
		dt = Math.Min(dt, 0.1f);
		var n = Math.Max(1, (int)MathF.Ceiling(dt * 120f));
		for (var i = 0; i < n; i++) _engine.Tick(dt / n);
		return _engine.Snapshot();
	}


	[JSInvokable]
	public void SetTarget(int side, float? y) => _engine?.SetTarget(side, y);

	[JSInvokable]
	public void Restart() => _engine?.Reset();

	public async ValueTask DisposeAsync()
	{
		try
		{
			if (_pong is not null) { await _pong.InvokeVoidAsync("stop"); await _pong.DisposeAsync(); }
			if (_net is not null) await _net.DisposeAsync();
		}
		catch (JSDisconnectedException) { }
		_self?.Dispose();
	}
}
