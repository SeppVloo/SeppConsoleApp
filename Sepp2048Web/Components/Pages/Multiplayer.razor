@page "/multiplayer"
@rendermode InteractiveServer
@using Sepp2048Web.Services
@implements IDisposable
@inject RoomManager RoomManager

<PageTitle>2048 - Multiplayer</PageTitle>

<div class="game-page">
    <div class="game-header">
        <div>
            <h1>2048 multiplayer</h1>
            <p>Meld je aan met je naam en speel om beurten op verschillende apparaten.</p>
        </div>
    </div>

    <div class="room-selection">
        <h3>Rooms</h3>
        @if (RoomManager.Rooms.Count == 0)
        {
            <p><em>Geen rooms aangemaakt.</em></p>
        }
        else
        {
            <ul class="room-list">
                @foreach (var room in RoomManager.Rooms)
                {
                    var isSelected = selectedRoom is not null && selectedRoom.Id == room.Id;
                    <li>
                        <button class="btn btn-link" @onclick="() => SelectRoom(room.Id)">@(room.Name)</button>
                        @if (isSelected)
                        {
                            <strong> (geselecteerd)</strong>
                        }
                    </li>
                }
            </ul>
        }

        <div class="create-room">
            <input class="form-control" placeholder="Nieuwe room naam" @bind="roomNameInput" />
            <button class="btn btn-primary" @onclick="CreateRoom">Maak room</button>
        </div>
    </div>

    @if (selectedRoom is not null && me is null)
    {
        <div class="join-panel">
            <h2>Aanmelden</h2>
            @if (activeLobby is null)
            {
                <p>Kies eerst een room om deel te nemen.</p>
            }
            else if (activeLobby.Started)
            {
                <p>Het spel is al gestart. Wacht tot het spel afgelopen is.</p>
            }
            else
            {
                <form @onsubmit="Join" @onsubmit:preventDefault="true">
                    <input class="form-control name-input"
                           placeholder="Jouw naam"
                           maxlength="20"
                           @bind="nameInput"
                           @bind:event="oninput" />
                    <button class="btn btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(nameInput)">
                        Doe mee
                    </button>
                </form>
                @if (!string.IsNullOrEmpty(joinError))
                {
                    <p class="error">@joinError</p>
                }
            }

            <h3>Spelers in de lobby</h3>
            @if (activeLobby is null || activeLobby.Players.Count == 0)
            {
                <p><em>Nog geen spelers aangemeld.</em></p>
            }
            else
            {
                <ul class="player-list">
                    @foreach (var player in activeLobby.Players)
                    {
                        <li>@player.Name</li>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <div class="score-panel">
            <div class="score-box">
                <span>Winnende score</span>
                <strong>@(activeLobby?.WinningScore ?? 2048)</strong>
            </div>
            <div class="score-box">
                <span>Aan zet</span>
                <strong>@(activeLobby?.GetCurrentPlayer()?.Name ?? "-")</strong>
            </div>
        </div>

        <div class="player-bar">
            <span>Spelers:</span>
            @foreach (var player in activeLobby?.Players ?? Array.Empty<Player>())
            {
                var isCurrent = (activeLobby?.Started ?? false) && player.Id == (activeLobby?.CurrentPlayerId ?? Guid.Empty);
                var isMe = player.Id == me.Id;
                <span class="player-chip @(isCurrent ? "current" : "") @(isMe ? "me" : "")">
                    @player.Name@(isMe ? " (jij)" : "") - @player.Score
                </span>
            }
        </div>

        @if (!(activeLobby?.Started ?? false))
        {
            <div class="start-panel">
                <p>Wachten tot een speler het spel start.</p>
                <div class="mb-2">
                    <label>Winnende score</label>
                    <input class="form-control" type="number" @bind="winningScoreInput" min="2" />
                </div>
                <button class="btn btn-primary" @onclick="StartGame">Start spel</button>
                <button class="btn btn-link" @onclick="Leave">Verlaat lobby</button>
            </div>
        }
        else
        {
            @if (activeLobby?.HasWon ?? false)
            {
                <div class="alert alert-success">2048 bereikt. Speel gerust door.</div>
            }

            @if (activeLobby?.IsGameOver ?? false)
            {
                <div class="alert alert-warning">Geen zetten meer mogelijk.</div>
            }

            var isMyTurn = (activeLobby?.CurrentPlayerId ?? Guid.Empty) == me.Id;

            <div class="game-shell @(isMyTurn ? "" : "disabled")"
                 tabindex="0"
                 @onkeydown="HandleKeyDown"
                 @onkeydown:preventDefault="true">
                <div class="board" aria-label="2048 spelbord">
                    @{
                        var board = activeLobby?.Board ?? new int[GameLobbyService.BoardSize, GameLobbyService.BoardSize];
                    }
                    @for (var row = 0; row < GameLobbyService.BoardSize; row++)
                    {
                        @for (var column = 0; column < GameLobbyService.BoardSize; column++)
                        {
                            var value = board[row, column];
                            <div class="tile @GetTileCssClass(value)">@(value == 0 ? string.Empty : value)</div>
                        }
                    }
                </div>

                <div class="controls" aria-label="Bewegingsknoppen">
                    <div class="spacer"></div>
                    <button class="move-button" disabled="@(!isMyTurn)" @onclick='() => Move(MoveDirection.Up)'>@((MarkupString)"&uarr;")</button>
                    <div class="spacer"></div>
                    <button class="move-button" disabled="@(!isMyTurn)" @onclick='() => Move(MoveDirection.Left)'>@((MarkupString)"&larr;")</button>
                    <button class="move-button" disabled="@(!isMyTurn)" @onclick='() => Move(MoveDirection.Down)'>@((MarkupString)"&darr;")</button>
                    <button class="move-button" disabled="@(!isMyTurn)" @onclick='() => Move(MoveDirection.Right)'>@((MarkupString)"&rarr;")</button>
                </div>
            </div>

                <p class="hint">
                @(isMyTurn ? "Het is jouw beurt." : $"Wachten op {activeLobby?.GetCurrentPlayer()?.Name}.")
            </p>

            <button class="btn btn-link" @onclick="Leave">Verlaat lobby</button>
        }
    }
</div>

@code {
    private Player? me;
    private string nameInput = string.Empty;
    private string? joinError;
    private int winningScoreInput = 2048;

    private GameRoom? selectedRoom;
    private GameLobbyService? activeLobby;
    private string roomNameInput = string.Empty;

    protected override void OnInitialized()
    {
        var rm = RoomManager;
        rm.Changed += OnRoomsChanged;
        OnRoomsChanged();
    }

    private async void OnLobbyChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnRoomsChanged()
    {
        // if no room selected but rooms exist, auto-select the first one
        if (selectedRoom is null && RoomManager.Rooms.Count > 0)
        {
            SelectRoom(RoomManager.Rooms[0].Id);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void Join()
    {
        joinError = null;
        try
        {
            if (activeLobby is null)
            {
                throw new InvalidOperationException("Geen actieve room geselecteerd.");
            }

            me = activeLobby.AddPlayer(nameInput);
        }
        catch (Exception ex)
        {
            joinError = ex.Message;
        }
    }

    private void StartGame()
    {
        if (me is not null)
        {
            activeLobby?.StartGame(me.Id, winningScoreInput);
        }
    }

    private void Leave()
    {
        if (me is not null)
        {
            activeLobby?.RemovePlayer(me.Id);
            me = null;
            nameInput = string.Empty;
        }
    }

    private void Move(MoveDirection direction)
    {
        if (me is null)
        {
            return;
        }

        activeLobby?.TryMove(me.Id, direction);
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (me is null)
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowUp":
                Move(MoveDirection.Up);
                break;
            case "ArrowDown":
                Move(MoveDirection.Down);
                break;
            case "ArrowLeft":
                Move(MoveDirection.Left);
                break;
            case "ArrowRight":
                Move(MoveDirection.Right);
                break;
        }
    }

    private static string GetTileCssClass(int value) => value switch
    {
        0 => "tile-0",
        2 => "tile-2",
        4 => "tile-4",
        8 => "tile-8",
        16 => "tile-16",
        32 => "tile-32",
        64 => "tile-64",
        128 => "tile-128",
        256 => "tile-256",
        512 => "tile-512",
        1024 => "tile-1024",
        2048 => "tile-2048",
        _ => "tile-super"
    };

    public void Dispose()
    {
        var rm = RoomManager;
        if (rm is not null)
        {
            rm.Changed -= OnRoomsChanged;
        }

        if (activeLobby is not null)
        {
            activeLobby.Changed -= OnLobbyChanged;
        }
        if (me is not null)
        {
            activeLobby?.RemovePlayer(me.Id);
        }
    }

    private void CreateRoom()
    {
        var rm = RoomManager;
        var room = rm.CreateRoom(roomNameInput);
        roomNameInput = string.Empty;
        SelectRoom(room.Id);
    }

    private void SelectRoom(Guid id)
    {
        var rm = RoomManager;
        selectedRoom = rm.GetRoom(id);

        if (activeLobby is not null)
        {
            activeLobby.Changed -= OnLobbyChanged;
        }

        activeLobby = selectedRoom?.Lobby;

        if (activeLobby is not null)
        {
            activeLobby.Changed += OnLobbyChanged;
        }

        // ensure UI updates after selection
        InvokeAsync(StateHasChanged);
    }
}
